# Read-only source archive — 189M, contains a Discogs token.
# M0 reads from here and writes elsewhere; it never belongs in git.
Pre August 2026/

# Secrets — never commit, in any location
*discogs_personal_access_token*
.dev.vars
.env
.env.*

# pm-next generated janitor report (per install step 3)
project/reports/

# OS / tooling
.DS_Store
node_modules/
dist/
.wrangler/

# Vite build output and TS build info
.vite/
*.tsbuildinfo

# Local D1 / SQLite fixtures built by the schema gate
data/*.sqlite

# Deploy seed, regenerated from the committed CSV in one command
data/seed.sql

# Cached Discogs release JSON — regenerated by tools/reverify.mjs
data/discogs-release-cache.json
data/reverify.json

# wrangler local state (miniflare D1 etc)
.wrangler/

# Local match database and its report inputs
data/deep-groove.sqlite
data/match-run.json

# Label photographs for SPIKE-PHOTO-TO-FIELDS — Joe's own photos, large
# and numerous. The typed ground truth beside them IS committed: it is
# the evidence, and it is what makes a re-run a comparison.
data/label-photos/*.jpg
data/label-photos/*.jpeg
data/label-photos/*.png
data/label-photos/*.webp
