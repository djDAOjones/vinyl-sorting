{
  "name": "deep-groove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catalogue, verify and organise a classical vinyl collection.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
